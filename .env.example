# 로컬 실행용 자격증명. 이 파일을 .env 로 복사해서 채운다.
# .env 는 .gitignore 에 들어 있으니 커밋되지 않는다.
#
# 참고: snapshot.py 는 이 저장소의 .env 를 먼저 보고, 없으면
# ../stock-research-app/backend/.env 를 찾는다.

# KRX 회원 계정 — pykrx 1.2.8+ 는 수급 데이터 조회에 로그인이 필수다.
# 없으면 에러가 아니라 빈 응답이 와서 "휴장일"과 구분되지 않는다.
KRX_ID=
KRX_PW=

# 네이버 개발자센터 — 뉴스 검색 (없으면 뉴스 건수만 비고 나머지는 정상 동작)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 — 브리핑 발송용. 보통 GitHub Actions Secrets 에만 두면 되고,
# 로컬에서 briefing.py 를 시험 발송할 때만 필요하다.
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=
KAKAO_REFRESH_TOKEN_2=
